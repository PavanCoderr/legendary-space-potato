# QubitVerse Backend Environment Variables
# Copy this file to .env and fill in the values.
# Never commit your actual .env file.

# JWT signing secret — required in production
JWT_SECRET=change-me-in-production

# Server port
PORT=8080

# CORS origin (frontend URL)
CORS_ORIGIN=http://localhost:5173

# Database URL (SQLite file path)
DATABASE_URL=data/qubitverse.db

# AI Provider API Keys — set at least one to enable the AI tutor
# Priority: OPENAI_API_KEY → ANTHROPIC_API_KEY → OPENROUTER_API_KEY → stub
# IMPORTANT: Never commit actual API keys; only set them in backend/.env or Render env vars

# OpenAI-compatible endpoint (vyceai)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=agnes-3.0-flash
OPENAI_BASE_URL=https://vyceai.com/v1

# Anthropic (Claude) - alternative
# ANTHROPIC_API_KEY=your-anthropic-key-here
# ANTHROPIC_MODEL=claude-3-haiku-20240307

# OpenRouter - alternative free models available
# OPENROUTER_API_KEY=your-openrouter-key-here
# OPENROUTER_MODEL=qwen/qwen3-8b-7b-it:free
