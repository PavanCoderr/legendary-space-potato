{
  "name": "qubitverse-backend",
  "version": "0.1.0",
  "type": "module",
  "description": "QubitVerse backend API server",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx src/server.ts",
    "build": "tsc",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "lint": "echo \"No linter configured\" && exit 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.17.0",
    "pg": "^8.12.0",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "tsx": "^4.23.13",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.3",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^2.0.12",
    "@types/uuid": "^10.0.0",
    "supertest": "^7.1.0",
    "typescript": "^7.0.2",
    "vitest": "^3.0.0"
  }
}
