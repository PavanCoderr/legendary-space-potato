# QubitVerse Backend Environment Variables

# Required: Secret used to sign JWT tokens
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# Database
# Set to a path for file-based SQLite (default: ./data/qubitverse.db)
DATABASE_URL=/path/to/database.db

# CORS
# Set to your frontend domain(s), comma-separated
# Example: CORS_ORIGIN=https://your-frontend.vercel.app
CORS_ORIGIN=http://localhost:5173

# Server
PORT=8080

# AI Provider (optional — backend falls back to StubProvider if none set)
# Set one of these to enable real AI responses:
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
OPENROUTER_API_KEY=sk-or-...

# Optional model overrides
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-3-haiku-20240307
OPENROUTER_MODEL=google/gemini-2.0-flash-lite
